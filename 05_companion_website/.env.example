# PlastInMap Companion Website — Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM providers (Hypothesis Generator) ──────────────────────────────────────
# Set whichever provider(s) you have access to. The UI will show a status dot
# for each key that is loaded from the environment.

# OpenCode (big-pickle, Claude, GPT, DeepSeek, …) — https://opencode.ai/
OPENCODE_API_KEY=your_opencode_api_key_here

# OpenRouter (Llama, Mistral, Gemini, DeepSeek, Qwen, …) — https://openrouter.ai/keys
# Single key proxies 100+ models via the OpenAI SDK.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI (GPT-5 and GPT-4.1 families) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional: Neo4j knowledge graph services (live query enrichment) ───────────
# If not set, the Hypothesis Generator falls back to pre-computed tables only.
LIT_KG_NEO4J_URI=bolt://localhost:7688
LIT_KG_NEO4J_USER=neo4j
LIT_KG_NEO4J_PWD=password

PPI_KG_NEO4J_URI=bolt://localhost:7689
PPI_KG_NEO4J_USER=neo4j
PPI_KG_NEO4J_PWD=password
